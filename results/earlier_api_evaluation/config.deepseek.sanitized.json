{
  "llm": {
    "provider": "DeepSeek API",
    "base_url": "https://api.deepseek.com",
    "endpoint_path": "/chat/completions",
    "api_key_env": "DEEPSEEK_API_KEY",
    "generator_model": "deepseek-chat",
    "classifier_model": "deepseek-chat",
    "reviewer_model": "deepseek-chat",
    "temperature": 0.01,
    "max_output_tokens": 1800,
    "max_tokens_field": "max_tokens",
    "timeout_seconds": 300,
    "request_retries_total": 5,
    "retry_backoff_seconds": 1.2,
    "seed": null,
    "context_window": "not explicitly set; provider default at run time"
  },
  "execution": {
    "platform": "Adams/View",
    "version": "2025.1.1",
    "timeout_seconds": 180,
    "units": "mm-kg-s-N"
  },
  "orchestrator": {
    "max_attempts": 8,
    "generator_retries_total": 1,
    "freeze_stable_stages": true,
    "enable_segmented_repair": true,
    "enable_repair_memory": true,
    "prompt_code_context_chars": 5000,
    "prompt_log_context_chars": 1800,
    "stable_stage_freeze_threshold": 1,
    "max_repeated_signature_failures": 1
  }
}
